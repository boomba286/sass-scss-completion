{
  "name": "sass-scss-completion",
  "displayName": "Sass/SCSS IntelliSense",
  "description": "Completes Sass function and mixin parameters in SCSS, Sass, and Vue files, and the selectors a stylesheet defines in HTML, Vue, Svelte, and Astro templates.",
  "version": "0.3.0",
  "publisher": "boomba286",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boomba286/sass-scss-completion.git"
  },
  "bugs": {
    "url": "https://github.com/boomba286/sass-scss-completion/issues"
  },
  "homepage": "https://github.com/boomba286/sass-scss-completion#readme",
  "keywords": [
    "sass",
    "scss",
    "completion",
    "intellisense",
    "vscode",
    "trae",
    "react",
    "angular"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:svelte",
    "onLanguage:astro"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sass",
        "aliases": [
          "Sass",
          "sass"
        ],
        "extensions": [
          ".sass"
        ]
      }
    ],
    "configuration": {
      "title": "Sass/SCSS IntelliSense",
      "properties": {
        "sass-scss-completion.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional glob patterns excluded from workspace indexing, on top of the built-in list (dependency, build output, and cache directories). Each entry must be a single pattern, for example `vendor-legacy` or `**/generated/**`.",
          "examples": [
            [
              "vendor-legacy",
              "**/generated/**"
            ]
          ]
        },
        "sass-scss-completion.groups": {
          "type": "array",
          "default": [],
          "markdownDescription": "Pairs the stylesheets that define selectors (`styles`) with the templates those selectors are completed into (`targets`). When the list is empty, every stylesheet in the workspace is offered to every template, and each suggestion shows the folder and file name of its stylesheet.",
          "items": {
            "type": "object",
            "required": [
              "styles",
              "targets"
            ],
            "properties": {
              "styles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Glob patterns for the stylesheets that supply the selectors of this group, for example `assets/theme/**/*.scss` or `public/**/*.css`. SCSS, Sass, and CSS files are read."
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Glob patterns for the template files this group applies to, for example `src/**/*.vue`. An empty list applies the group to every template."
              },
              "label": {
                "type": "string",
                "markdownDescription": "Text shown to the right of each suggestion. Defaults to the folder and file name of the stylesheet that defines the selector."
              }
            }
          },
          "examples": [
            [
              {
                "styles": [
                  "assets/theme/**/*.scss"
                ],
                "targets": [
                  "src/**/*.vue"
                ],
                "label": "theme"
              },
              {
                "styles": [
                  "assets/admin/**/*.scss"
                ],
                "targets": [
                  "src/admin/**/*.html"
                ],
                "label": "admin"
              }
            ]
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "dev": "bash scripts/run.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node ./dist/test/runTest.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "vscode-css-languageservice": "^6.3.10"
  }
}
